# =============================================================
# GULLY STARS — Environment Configuration
# =============================================================

# --- Application ---
APP_NAME="Gully Stars"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
DATABASE_URL=postgresql+asyncpg://gullyuser:gullypass@localhost:5432/gullydb
POSTGRES_USER=gullyuser
POSTGRES_PASSWORD=gullypass
POSTGRES_DB=gullydb

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# --- Media Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
